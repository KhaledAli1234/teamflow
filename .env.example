# Environment & Project
ENVIRONMENT=development
PROJECT_NAME=TeamFlow
API_V1_PREFIX=/api/v1
DEBUG=false

# Database
DATABASE_URL=postgresql+psycopg://teamflow:teamflow_pass@localhost:5433/teamflow

# Security & Authentication
SECRET_KEY=change-me-to-a-super-secret-key-with-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate Limiting & Lockout
RATE_LIMIT_ENABLED=true
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# Password Reset & CORS
PASSWORD_RESET_EXPIRE_MINUTES=30
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]

# Redis & Celery
REDIS_URL=redis://localhost:6379/0

# Email (SMTP) - Mailpit for local dev
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
EMAIL_FROM="TeamFlow <no-reply@teamflow.local>"